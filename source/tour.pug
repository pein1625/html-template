extends layout/page

block content
    section.tour
        .tour__wrapper
            .container
                .position-relative
                    .tour__inner
                        .tour__search
                            .input-group
                                .input-group-text
                                    i.fal.fa-search
                                input.form-control(type="text", placeholder="Tìm kiếm tuyến du lịch ...")
                            .tour__dropdown
                                a.tour__dropdown-item(href="#!") Đền Văn Hiến
                                a.tour__dropdown-item(href="#!") Đền Văn Lang
                                a.tour__dropdown-item(href="#!") Đền Văn Vẻ
                                a.tour__dropdown-item(href="#!") Đền Văn Nghệ
                                a.tour__dropdown-item(href="#!") Đền Văn Chương
                        .tour__nav
                            .tour__nav-inner
                                +text-slider
                                //- a.tour__link(href="#!") Đền Văn Hiến
                                //- a.tour__link.active(href="#!") Miếu Hàm Rồng
                                //- a.tour__link(href="#!") Đình Bá Dương
                                //- a.tour__link(href="#!") Đình Đại Phùng
                                //- a.tour__link(href="#!") Đình Bá Dương
                                //- a.tour__link(href="#!") Đình Đại Phùng
                                //- a.tour__link(href="#!") Đình Bá Dương
                                //- a.tour__link(href="#!") Đình Đại Phùng
                                //- a.tour__link(href="#!") Đình Bá Dương
                                //- a.tour__link(href="#!") Đình Đại Phùng
        +map

    +s-about('GIỚI THIỆU', 'Du lịch tâm linh Huyện Đan Phượng')
    +s-virtual('TUYẾN DU LỊCH', 'Du lịch tâm linh Huyện Đan Phượng')
    +s-sample('Danh sách điểm đến của cụm di tích', 'Xem tất cả điểm đến của cụm di tích', 's-sample')
    +s-news('Cụm di tích liên quan', '', 's-position')
    +s-news('Các bài viết liên quan', 'pt-0', 's-post')
