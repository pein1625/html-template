extends layout/page

block content
    +breadcrumb('Trang chủ', 'Điểm đến')

    section.section.pt-2.pt-xl-4
        .container
            h1.section__title.mb-4.mb-lg-30.mb-xl-40.mb-xxl-60 Điểm đến

            .row
                .col-lg-4.mb-4.mb-lg-0
                    form.p-filter(action="#!")
                        +search-field(['Cụm di tích D', 'Cụm di tích D'])

                        .p-filter__menu.mt-4.mt-lg-40
                            ul.menu
                                li.menu-item
                                    span.menu-link Huyện
                                    span.menu-toggle
                                    .menu.menu-sub
                                        .mt-2
                                            +checkbox
                                                span.ml-1 Huyện A
                                        .mt-2
                                            +checkbox
                                                span.ml-1 Huyện B
                                        .mt-2
                                            +checkbox
                                                span.ml-1 Huyện C
                                li.menu-item
                                    span.menu-link Cụm di tích
                                    span.menu-toggle
                                    .menu.menu-sub
                                        .mt-2
                                            +checkbox
                                                span.ml-1 Cụm di tích 1
                                        .mt-2
                                            +checkbox
                                                span.ml-1 Cụm di tích 2
                                        .mt-2
                                            +checkbox
                                                span.ml-1 Cụm di tích 3

                .col-lg-8
                    .row.g-3.g-xl-30
                        .col-6
                            +product('./images/img-1.jpg', './place-detail.html', './images/icon-map-markers.png', 'product--place')
                        .col-6
                            +product('./images/img-2.jpg', './place-detail.html', './images/icon-map-marker.png', 'product--place')
                        .col-6
                            +product('./images/img-3.jpg', './place-detail.html', './images/icon-map-markers.png', 'product--place')
                        .col-6
                            +product('./images/img-4.jpg', './place-detail.html', './images/icon-map-markers.png', 'product--place')
                        .col-6
                            +product('./images/img-5.jpg', './place-detail.html', './images/icon-map-markers.png', 'product--place')
                        .col-6
                            +product('./images/img-1.jpg', './place-detail.html', './images/icon-map-markers.png', 'product--place')

                    nav.d-flex.justify-content-center.mt-30
                        +pagination
