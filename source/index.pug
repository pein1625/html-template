                .rule__footer
                    a.button(href="#!") Xem thêm

    section.section
        .texture-2
        .container
            h2.section__title.text-white Danh sách trúng thưởng

            nav.n-tab
                a.button.active(href="#!") Tuần này
                a.button.button--white(href="#!") Tháng này
                a.button.button--white(href="#!") Từ đầu chương trình

            .data-tbl
                table.table.table-borderless.js-datatable
                    thead
                        tr
                            th STT
                            th Tên khách hàng
                            th Số điện thoại
                            th Số CCCD/CMND
                            th Ngày đăng ký
                            th Giải thưởng
                            th Đại lý
                    tbody
                        - for(let i = 0; i < 10; i++)
                            tr
                                td #{i == 9 ? '10' : '0' + (i+1)}
                                td Trương Văn Thắng
                                td 0987654***
                                td 0123456***
                                td 20/10/2024
                                td Xe Vespa
                                td Xuân Cầu Vespa

                .data-tbl__footer
                    .data-tbl__search
                        .input-group
                            input.form-control(type="text", placeholder="Tìm kiếm thông tin")
                            button.input-group-text(type="button")
                                i.far.fa-lg.fa-search

                    .data-tbl__content
                        div Có #[strong.text-danger 93] đại lý trong danh sách này

                    .data-tbl__pagination
                        +pagination

    section.section.h-contact
        .texture-1
        .container
            h2.section__title.text-white Liên hệ đại lý
            .section__desc.text-white Hãy là những khách hàng đầu tiên tham gia và trúng giải thưởng của chương trình

            .mt-50
                .row
                    .col-lg-7
                        // todo hapk make the bike play
                        .h-contact__bike
                            img(src="./images/bike-white.png", alt="")
                    .col-lg-5
                        form.form-contact(action="#!")
                            .row.g-2
                                .col-lg-6
                                    label.form-label Họ và tên
                                    input.form-control(type="text")
                                .col-lg-6
                                    label.form-label Số điện thoại
                                    input.form-control(type="text")
                                .col-12
                                    label.form-label Địa chỉ
                                    input.form-control(type="text")
                                .col-lg-6
                                    label.form-label Đại lý
                                    select.form-select.js-select2
                                        option XUÂN CẦU PIAGGIO
                                        option HẠ CẦU PIAGGIO
                                        option THU CẦU PIAGGIO
                                        option ĐÔNG CẦU PIAGGIO
                                .col-lg-6
                                    label.form-label Loại xe quan tâm
                                    select.form-select.js-select2
                                        option Loại xe 1
                                        option Loại xe 2
                                        option Loại xe 3
                                        option Loại xe 4
                                        option Loại xe 5
                                .col-12
                                    label.form-label Ghi chú
                                    textarea.form-control(rows="4")
                                .col-12
                                    .form-contact__desc
                                        div Bạn đang liên hệ tới đại lý: Xuân Cầu Piaggio
                                        div Hotline: 0900 0000 000 - Email: xuancau@gmail.com

                            button.form-contact__btn.button(type="submit") Liên hệ đại lý

        .h-contact__footer
            .container
                .row
                    .col-lg-5.ms-auto
                        .h-contact__info
                            .h-contact__item
                                .h-contact__icon
                                    i.fal.fa-fw.fa-2x.fa-phone-volume
                                div
                                    div Hotline miễn phí
                                    a.fw-700(href="tel:19000000") 1900 0000
                            .h-contact__item
                                .h-contact__icon
                                    i.fal.fa-fw.fa-2x.fa-map-marker-alt
                                div Đại lý toàn quốc
