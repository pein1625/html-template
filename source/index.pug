extends layout/page

block content
    // category
    section.category
        .container
            .category__desc Các thông tin đơn vị, doanh nghiệp, cá nhân cung cấp trên hệ thống chỉ sử dụng cho mục đích nghiên cứu, thống kê, xây dựng chỉ số thương mại Thái Nguyên. Chúng tôi cam kết không tiết lộ thông tin này cho bên thứ ba.

            .category__grid
                each item in ['Khảo sát', 'Thống kê TMĐT', 'Chỉ số TMĐT Việt Nam', 'Chỉ số TMĐT Thái Nguyên', 'Tài liệu']
                    .category__item
                        a.category__frame(href="#!")
                            img(src="https://placehold.co/200x200", alt="")
                        h3.category__title
                            a(href="#!")= item

    // banner slider
    +banner-slider

    // grid
    section.py-40
        .container
            .row
                .col-lg-4.mb-4.mb-lg-0
                    section.section-6
                        h2.section-6__title Sàn thương mại điện tử

                        .pd-grid
                            - for(let i = 0; i < 6; i++)
                                .pd-grid__col
                                    a.pd-grid__frame(href="#!")
                                        img(src="https://placehold.co/100x75", alt="")
                                    h3.pd-grid__title
                                        a(href="#!")  Trà xanh Biển Xuân
                                    .pd-grid__price 1,500,000 VNĐ

                .col-lg-4.mb-4.mb-lg-0
                    section.section-6
                        h2.section-6__title Tin tức công thương

                        .mt-3
                            +news-3
                        .mt-3
                            +news-3
                        .mt-3
                            +news-3

                .col-lg-4
                    section.section-7
                        h2.section-7__title Thông tin nhanh

                        .mb-3
                            +news-2
                        .mb-3
                            +news-2('danger')
                        .mb-3
                            +news-2('danger')
