    section.section.h-contact
        img.section__bg(src="./images/rule-bg.jpg", alt="")
        .section__backdrop
        .container-fluid
            h2.section__title LIÊN HỆ ĐẠI LÝ
            .section__desc.section__desc--2 Hãy là những khách hàng đầu tiên tham gian và trúng giải thưởng của chương trình

            .pt-20.pb-50
                .row.align-items-center
                    .col-lg-6.d-none.d-lg-block
                        img.w-100(src="./images/home-contact-img.png", alt="")
                    .col-lg-6
                        form.form-contact(action="#!")
                            .row.g-3
                                .col-lg-6
                                    label.form-label Họ và tên
                                    input.form-control(type="text")
                                .col-lg-6
                                    label.form-label Số điện thoại
                                    input.form-control(type="text")
                                .col-12
                                    label.form-label Địa chỉ
                                    input.form-control(type="text")
                                .col-12
                                    label.form-label Tỉnh/Thành phố
                                    select.form-select.js-select2
                                        option Hà Nội
                                        option Đà Nẵng
                                        option Cần Thơ
                                        option TP HCM
                                .col-12
                                    label.form-label Đại lý
                                    select.form-select.js-select2
                                        option XUÂN CẦU PIAGGIO
                                        option HẠ CẦU PIAGGIO
                                        option THU CẦU PIAGGIO
                                        option ĐÔNG CẦU PIAGGIO
                                .col-12
                                    label.form-label Loại xe quan tâm
                                    select.form-select.js-select2
                                        option Loại xe 1
                                        option Loại xe 2
                                        option Loại xe 3
                                        option Loại xe 4
                                        option Loại xe 5
                                .col-12
                                    label.form-label Ghi chú
                                    textarea.form-control(rows="4")
                                .col-12
                                    .form-contact__desc
                                        div Bạn đang liên hệ tới đại lý: Xuân Cầu Piaggio
                                        div Hotline: 0900 0000 000 - Email: xuancau@gmail.com
                                .col-12.text-center.pt-2
                                    button.form-contact__btn.button.button--secondary(type="submit") LIÊN HỆ ĐẠI LÝ

        .h-contact__footer
            .container
                .row
                    .col-lg-5.ms-auto
                        .h-contact__info
                            .h-contact__item
                                .h-contact__icon
                                    i.fal.fa-fw.fa-2x.fa-phone-volume
                                div
                                    div Hotline miễn phí
                                    a.fw-700(href="tel:19000000") 1900 0000
                            .h-contact__item
                                .h-contact__icon
                                    i.fal.fa-fw.fa-2x.fa-map-marker-alt
                                div Đại lý toàn quốc
