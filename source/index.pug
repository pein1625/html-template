extends layout/page
block footer
block content
    section.section.py-0
        .home-banner
            .home-banner__inner
                img.home-banner__bg(src="./images/home-banner.png", alt="")
                img.home-banner__product-1(src="./images/vespa-red-right.png", alt="")
                img.home-banner__product-2(src="./images/liberty-white-left.png", alt="")
                .home-banner__group-1
                    .home-banner__text-1 25.12.2025 - 13.02.2026
                    .home-banner__text-2 Chương trình áp dụng cho tất cả khách hàng mua xe #[span.text-danger Piaggio/Vespa]
                .home-banner__group-2
                    .home-banner__text-3 #[span.text-danger HÀNG NGÀN] Quà tặng & Lì xì
                        br
                        | Phụ kiện chính hãng cao cấp
                    img.home-banner__product-3(src="./images/home-banner-product-3.png", alt="")
                .home-banner__group-3
                    img.home-banner__text-label(src="./images/home-banner-text-label.png", alt="")
                    .home-banner__text-4 XE MÁY PIAGGIO
                        br
                        | LIBERTY 125
                        br
                        | PHIÊN BẢN Z
            .mobile-bg.d-md-none
                img.mobile-bg__1(src="./images/mobile-bg-1.jpg", alt="")
                img.mobile-bg__2(src="./images/mobile-bg-2.png", alt="")
                img.mobile-bg__3(src="./images/mobile-bg-3.png", alt="")
            .home-banner__footer
                .container
                    .home-banner__footer-inner
                        .countdown.js-countdown(data-countdown="2026-01-01 12:00:00")
                            .countdown__item
                                span.countdown__number 27
                                span ngày
                            .countdown__item
                                span.countdown__number 11
                                span giờ
                            .countdown__item
                                span.countdown__number 02
                                span phút
                            .countdown__item
                                span.countdown__number 04
                                span giây

                        .gift-remaining
                            .gift-remaining__label Còn lại
                            .gift-remaining__item
                                span.gift-remaining__number 50
                                span Giải Đặc Biệt
                            .gift-remaining__item
                                span.gift-remaining__number 250
                                span Giải Nhất
                            .gift-remaining__item
                                span.gift-remaining__number 1000
                                span Giải Nhì
                            .gift-remaining__item
                                span.gift-remaining__number 1700
                                span Giải Khuyến Khích
