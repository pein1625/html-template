extends layout/page

block script
    script(async src="https://maps.googleapis.com/maps/api/js?key=AIzaSyC0hNc0IKJXYQzNTWtGesMaT5pcJzXMPQY&loading=async&callback=initMap")

block content
    section.h-banner
        .h-banner__frame-bg
            iframe(src="https://danphuong.zend.website/banner-360/", frameborder="0")
        .h-banner__logo
            img(src="./images/logo.png", alt="")
        .h-banner__label CỔNG THÔNG TIN DU LỊCH
        .h-banner__name Huyện Đan Phượng
        .text-center
            a.button(href="#!") Trải nghiệm 360
        .h-banner__btn-wrap
            a.h-banner__btn.js-home-page-scroll-down(href="#!")
                i.fal.fa-arrow-down

    section.about.section.js-home-scroll-section
        .container
            .about__inner
                img.about__bg(src="./images/about-bg.png", alt="")
                .row
                    .col-lg-5.mb-4.mb-lg-0
                        h2.about__title.section__title.text-primary Đan Phượng
                        .about__subtitle Đôi nét về một huyện
                            br
                            | của Hà Nội
                        .about__content
                            p "#[strong Nằm ở phía Tây Bắc thủ đô Hà Nội, Đan Phượng là một huyện thuộc Hà Nội.] Đan Phượng cách trung tâm thành phố khoảng 20km theo trục đường quốc lộ 32. Huyện Đan Phượng nằm tiếp giáp với 5 quận huyện của Hà Nội:
                            p.fw-700 - Phía Bắc giáp huyện Mê Linh, ranh giới là sông Hồng
                                br
                                | - Phía Nam giáp huyện Hoài Đức
                                br
                                | - Phía Đông giáp quận Bắc Từ Liêm và huyện Đông Anh
                                br
                                | - Phía Tây giáp huyện Phúc Thọ, ranh giới là sông Đáy
                            p Huyện Đan Phượng nằm tại khoảng giữa của trục quốc lộ 32 từ trung tâm thủ đô đi Sơn Tây. Cụ thể, nếu đi từ phía Hà Nội lên Sơn Tây đến km 16+500 là ngã Tư Trôi (Hoài Đức) rẽ phải khoảng 300m là đến huyện Đan Phượng. Đan Phượng được đánh giá là huyện có diện tích tự nhiên thuộc loại nhỏ, ít đơn vị hành chính trực thuộc.
                                br
                                | Huyện có hệ thống sông Hồng, sông Đáy chảy qua, trước kia là ngã ba sông (sông Đáy, sông Nhuệ, sông Hồng) nên #[strong địa hình khá bằng phẳng, chủ yếu là đất phù sa, độ cao trung bình từ 6-8m.]"
                    .col-lg-7
                        img.w-full.rounded(src="./images/about.jpg", alt="")

    section.counter.section
        img.section__bg(src="./images/counter-bg.png", alt="")
        .container
            .counter__inner
                .counter__item
                    .counter__number +50
                    .counter__label Di tích
                    .counter__desc Trải qua thăng trầm lịch sử
                .counter__item
                    .counter__number +2000
                    .counter__label Hiện vật
                    .counter__desc Qua các thời đại
                .counter__item
                    .counter__number >100
                    .counter__label Tuyến du lịch
                    .counter__desc Cho khách trải nghiệm
                .counter__item
                    .counter__number >100
                    .counter__label Sản phẩm
                    .counter__desc Cho khách trải nghiệm

    section.section.offset-section
        img.texture-5(src="./images/texture-1.png", alt="")
        img.texture-4(src="./images/texture-4.png", alt="")
        img.texture-3(src="./images/texture-3.png", alt="")
        .container
            h2.section__title.text-primary Điểm đến
            .section__subtitle Những địa điểm nổi bật
            .section__desc Cùng khám phá ngay những điểm đến tuyệt vời ở Đan Phượng bạn nhé!

            .mt-4
                +card-slider
                    - for(let i = 0; i < 6; i++)
                        .swiper-slide
                            +place(`./images/img-${i % 5 + 1}.jpg`)

            .mt-4.text-center
                a.button(href="#!") Xem tất cả

    section.section.pb-0
        .container
            h2.section__title.text-primary Tuyến du lịch
            .section__subtitle Những tuyến du lịch nổi bật
            .section__desc Mời bạn chọn tuyến du lịch yêu thích tại đây, khám phá ngay nào!
            .mt-3.mb-40.mx-auto.position-relative(style="max-width: 790px; z-index: 100")
                .route
                    .route__select
                        span Chọn tuyến
                        i.fal.fa-fw.fa-angle-down
                    .route__dropdown
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox', data-route="tuyen_1")
                                span.checkbox-styled__icon
                                strong Tuyến A:
                                span.ms-1 Hạ Mỗ (Hồng Thái)
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox', data-route="tuyen_2")
                                span.checkbox-styled__icon
                                strong Tuyến B:
                                span.ms-1 Miếu Đinh Nguyên (xã Thọ An)
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox', data-route="tuyen_3")
                                span.checkbox-styled__icon
                                strong Tuyến C:
                                span.ms-1 Đền Nhã Lang (xã Hạ Mỗ)
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox', data-route="tuyen_4")
                                span.checkbox-styled__icon
                                strong Tuyến D:
                                span.ms-1 Đình chùa Phương Mạc (xã Phương Đình)
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox', data-route="tuyen_5")
                                span.checkbox-styled__icon
                                strong Tuyến E:
                                span.ms-1 Đền Văn Hiến - Thờ Thái úy Phụ chính Tô Hiến Thành (xã Hạ Mỗ)
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox', data-route="tuyen_6")
                                span.checkbox-styled__icon
                                strong Tuyến F:
                                span.ms-1 Đình Vạn Xuân (xã Hạ Mỗ)
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox', data-route="tuyen_7")
                                span.checkbox-styled__icon
                                strong Tuyến G:
                                span.ms-1 Đình chùa Phương Mạc (xã Phương Đình)
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox', data-route="tuyen_8")
                                span.checkbox-styled__icon
                                strong Tuyến H:
                                span.ms-1 Miếu Xương Rồng (xã Liên Hồng)
                        .route__item
                            label.checkbox-styled
                                input.checkbox-styled__input(type="checkbox", name='location', class='js-location-checkbox')
                                span.checkbox-styled__icon
                                strong Tuyến I:
                                span.ms-1 Đình chùa Phương Mạc (xã Phương Đình)

        +map

    section.section
        img.texture-1(src="./images/texture-1.png", alt="")
        img.texture-2(src="./images/texture-2.png", alt="")
        .section__bg-1
        .container
            h2.section__title.text-primary Tin tức
            .section__subtitle Những tin tức cập nhật mới nhất
            .section__desc Cùng cập nhật tin tức để biết tường tận về những di tích, cảnh đẹp và điểm đến không thể bỏ qua tại Đan Phượng
            .mt-4
                +news-slider
            .mt-4.text-center
                a.button(href="#!") Xem tất cả
