extends layout/page

block content
    +breadcrumb('Trang chủ', 'Hiện vật 3D')

    section.s-products.pt-10.pb-60
        .container
            .row
                .col-lg-4.mb-4.mb-lg-0
                    .s-products__subtitle Hiện vật
                    h1.s-products__title 3D
                    .s-products__desc Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy tincidunt ut Ut wisi enim ad minim veniam

                    form.p-filter(action="#!")
                        +search-field(['Cụm di tích A', 'Cụm di tích B'])

                        .p-filter__menu.mt-4.mt-lg-40
                            ul.menu
                                each item in ['Cụm di tích 1', 'Cụm di tích 2', 'Cụm di tích 3', 'Cụm di tích 4']
                                    li.menu-item
                                        span.menu-link= item
                                        span.menu-toggle
                                        .menu.menu-sub
                                            .mt-2
                                                +checkbox
                                                    span.ml-1 Cụm di tích A
                                            .mt-2
                                                +checkbox
                                                    span.ml-1 Cụm di tích B
                                            .mt-2
                                                +checkbox
                                                    span.ml-1 Cụm di tích C

                .col-lg-8
                    .row.g-3.g-xl-30
                        - for(let i = 0; i < 8; i++)
                            .col-6
                                +product(`./images/img-${i % 5 + 1}.jpg`, './sample-detail.html')

                    nav.d-flex.justify-content-center.mt-30
                        +pagination
