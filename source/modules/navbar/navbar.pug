mixin navbar
  section.navbar.js-navbar
    .navbar__backdrop.js-navbar-toggle
    .navbar__wrapper
      .navbar__header
        a.h-logo(href="./index.html")
          img(src="./images/logo.png", alt="")
          .h-logo__text
            span Số hóa
            span Đan Phượng
        button.btn-toggle.js-navbar-toggle.ms-auto
      .navbar__body
        block
