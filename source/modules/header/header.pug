include ../navbar/navbar
include ../menu/menu

mixin header
  header.header
    .header__wrapper
      .container
        .header__inner
          a.header__logo(href="./index.html")
            img(src="./images/logo-2.png", alt="")
          .header__elements.ms-2.ms-xl-3
            +navbar
              +menu(menu)

          .h-dropdown.ms-2.ms-xl-3
            a.h-dropdown__toggle(href="#!")
              img(src="./images/gb.svg", alt="")

            .h-dropdown__menu
              a.h-dropdown__item(href="#!")
                img(src="./images/gb.svg", alt="")
                span English
              a.h-dropdown__item(href="#!")
                img(src="./images/vn.svg", alt="")
                span Tiếng Việt

          .h-dropdown.ms-2.ms-xl-3
            a.h-dropdown__toggle(href="#!")
              img(src="./images/user-white.svg", alt="")

            .h-dropdown__menu
              a.h-dropdown__item(href="#!") Dropdown item 1
              a.h-dropdown__item(href="#!") Dropdown item 2
              a.h-dropdown__item(href="#!") Dropdown item 3
              a.h-dropdown__item(href="#!") Dropdown item 4

          button.btn-toggle.text-white.d-xl-none.js-navbar-toggle.ms-2
