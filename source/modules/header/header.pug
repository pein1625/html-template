include ../navbar/navbar
include ../menu/menu

mixin header
  header.header
    .header__wrapper
      .container-fluid
        .header__inner
          a.header__logo(href="./index.html")
            img(src="./images/logo-3.png", alt="")
          .header__elements.ms-2.ms-xl-3
            +navbar
              +menu(menu)

          .h-dropdown.ms-2.ms-xl-3
            a.h-dropdown__toggle(href="#!")
              img(src="./images/user-circle.svg", alt="")

            .h-dropdown__menu
              a.h-dropdown__item(href=".md-login", data-bs-toggle="modal") Login
              a.h-dropdown__item(href="#!") Dropdown item 2
              a.h-dropdown__item(href="#!") Dropdown item 3
              a.h-dropdown__item(href="#!") Dropdown item 4

          button.btn-toggle.text-white.d-xl-none.js-navbar-toggle.ms-2

mixin header-2
  header.header
    .header__wrapper
      .container-fluid
        .header__inner
          a.header__logo(href="./index.html")
            img(src="./images/logo-3.png", alt="")
          .header__elements.ms-2.ms-xl-3
          .h-dropdown.ms-2.ms-xl-3
            a.h-dropdown__toggle(href="#!")
              span.me-3.d-none.d-md-inline Đại lý Piaggio Xuân Cầu
              img(src="./images/user-circle.svg", alt="")

            .h-dropdown__menu
              a.h-dropdown__item(href=".md-login", data-bs-toggle="modal") Login
              a.h-dropdown__item(href="#!") Trang chủ
              a.h-dropdown__item(href="#!") Thể lệ
              a.h-dropdown__item(href="#!") Đăng ký
              a.h-dropdown__item(href="#!") Danh sách khách hàng
              a.h-dropdown__item(href="#!") Thông tin người dùng

mixin header-3
  header.header
    .header__wrapper
      .container-fluid
        .header__inner
          a.header__logo(href="./index.html")
            img(src="./images/logo-3.png", alt="")
