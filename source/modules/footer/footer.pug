mixin footer(statistic = true)
  footer.footer
    .container
      .footer__grid
        .footer__col.me-auto
          .footer__copyright @Bản quyền thuộc Sở Công Thương tỉnh Thái Nguyên
          .footer__title Hệ thống khảo sát thương mại điện tử tỉnh Thái Nguyên
          .footer__content
            p Chịu trách nhiệm nội dung: #[strong Nguyễn Bá Chính - Giám đốc]
              br
              | Địa chỉ: 366/1, Đường Bắc Kạn, thành phố Thái Nguyên, tỉnh Thái Nguyên
              br
              | Điện thoại: 0208.3855.255
              br
              | Giấy phép số: .............do Sở Thông tin và Truyền thông tỉnh Thái Nguyên cấp
              br
              | ngày  tháng  năm 2024.

        .footer__col
          .f-support
            .f-support__label Hỗ trợ kỹ thuật
            a.f-support__phone(href="tel:0916.155.787") 0916.155.787
            .f-support__img
              img(src="./images/footer-qr.png", alt="")
        if (statistic)
          .footer__col
            .f-statistic
              .f-statistic__label Số người khảo sát
              .f-statistic__content TP. THÁI NGUYÊN: 00000
              .f-statistic__label Số người truy cập
              .f-statistic__content 8888888
              .f-statistic__label Số người online
              .f-statistic__content 8888888
