mixin footer
    footer.footer
        .footer__inner
            img.footer__bg-2(src="./images/footer-bg-2.png", alt="")
            img.footer__bg-3(src="./images/footer-bg-3.png", alt="")
            .container
                .footer__heading CỔNG THÔNG TIN DU LỊCH
                    br
                    | HUYỆN ĐAN PHƯỢNG - TP. HÀ NỘI
                ul.f-contact
                    li.f-contact__item
                        i.fal.fa-fw.fa-map-marker-alt.me-2
                        span Số 105 Phố Tây Sơn - thị trấn Phùng huyện Đan Phượng
                    li.f-contact__item
                        i.fal.fa-fw.fa-phone.me-2
                        a(href="tel:02433886384") 024. 33886384
                    li.f-contact__item
                        i.fal.fa-fw.fa-envelope.me-2
                        span Fax: 024. 33886384
                    li.f-contact__item
                        i.fal.fa-fw.fa-user.me-2
                        span Người phát ngôn: Đồng chí Lê Thanh Nam -Chủ tịch UBND huyện
                    li.f-contact__item
                        i.fal.fa-fw.fa-user.me-2
                        span Chịu trách nhiệm nội dung: Đồng chí: Đào Thị Hồng -Phó Chủ tịch UBND huyện
        .copyright
            .container © 2024 UBND huyện Đan Phượng
