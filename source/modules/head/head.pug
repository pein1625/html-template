- var rest = []

mixin head(data)
  head
    title Title
    meta(charset='utf-8')
    meta(name="description", content="Description")
    meta(name="viewport", content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no")

    // Styles
    link(rel="stylesheet", type="text/css", href="./css/libs.css")
    link(rel="stylesheet", type="text/css", href="./vendor/fontawesome-pro/css/all.min.css")

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    each item in rest
      if (cssList = data[item].css)
        each css in cssList
          link(rel="stylesheet", href=css)
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css")
    link(rel="stylesheet", type="text/css", href="./css/app.css")

    // Scripts
    script(src="./js/libs.js", defer)
    each item in rest
      if (jsList = data[item].js)
        each js in jsList
          script(src=js, defer)
    script(src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js", defer)
    script(src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js", defer)
    script(src="./js/app.js", defer)
