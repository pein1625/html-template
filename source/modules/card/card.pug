- count = 0
mixin product
    article.product
        a.product__frame(href='./product-detail.html')
            img(src='./images/product-1.jpg', alt="")
        .product__body
            h3.product__title
                a(href='./product-detail.html') Làng nghề tre nứa

mixin news(img='https://placehold.co/600x400')
    article.news
        a.news__frame(href="./news-detail.html")
            img(src=img, alt="")
        .news__body
            h3.news__title
                a(href="./news-detail.html") Lễ hội diều truyền thống
            .news__info
                span.news__tag Du lịch
                span.news__time 10/11/2022
            .news__desc Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy tincidunt ut Ut wisi enim ad minim veniam Lorem ipsum dolor sit amet, ...
            .mt-auto
                a.news__link(href="./news-detail.html") Xem thêm

