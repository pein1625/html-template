- count = 0

mixin 3d-frame(className='')
    iframe(class=className, allowfullscreen="true", src="https://momento360.com/e/u/a9b53aa8f8b0403ba7a4e18243aabc66")

mixin product(img='./images/product-1.jpg', url='./product-detail.html', icon='', className='')
    article.product(class=className)
        a.product__frame(href=url)
            img(src=img, alt="")
        .product__body
            if (icon)
                .product__icon
                    img(src=icon, alt="")
            h3.product__title
                a(href=url) Lorem ipsum dolor

mixin news(img='https://placehold.co/600x400', title='Lễ hội diều truyền thống', url='./news-detail.html', addClass='')
    article.news(class=addClass)
        a.news__frame(href=url)
            img(src=img, alt="")
        .news__body
            h3.news__title
                a(href=url)= title
            .news__info
                span.news__tag Du lịch
                span.news__time 10/11/2022
            .news__desc Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy tincidunt ut Ut wisi enim ad minim veniam Lorem ipsum dolor sit amet, ...
            .mt-auto
                a.news__link(href="./news-detail.html") Xem thêm

mixin news-2(img='https://placehold.co/600x400')
    article.news-2
        a.news-2__frame(href="./news-detail.html")
            img(src=img, alt="")
        .news-2__body
            h3.news-2__title
                a(href="./news-detail.html") Lorem ipsum dolor sit lorem ipsum dolor sit
            .news-2__desc Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy tincidunt ut Ut wisi enim....

mixin lib(img="./images/img-1.jpg")
    .lib
        .lib__frame
            a.lib__link(href=img data-fancybox="library")
                img(src=img, alt="")

mixin lib-2(videoId='f4qHIxmyXt4')
    .lib
        .lib__frame
            a.lib__link(href=`https://www.youtube.com/watch?v=${videoId}`, data-fancybox="library")
                img(src=`https://img.youtube.com/vi/${videoId}/0.jpg`, alt="")
                .lib__overlay
                    i.fas.fa-fw.fa-play

mixin lib-3
    .lib
        .lib__frame
            a.lib__link(href="https://momento360.com/e/u/a9b53aa8f8b0403ba7a4e18243aabc66", data-fancybox="library", data-type="iframe")
                +3d-frame
                .lib__overlay
                    img(src="./images/icon-360.png", alt="")

mixin sample(img="./images/img-1.jpg", title="Sư tử đá")
    .sample
        .sample__frame
            img(src=img, alt="")
        .sample__title= title
        a.sample__overlay(href="#!")
            img.sample__icon(src="./images/icon-place.png", alt="")
            .sample__overlay-title Sư tử đá
            .sample__overlay-desc Trải qua thăng trầm lịch sử
