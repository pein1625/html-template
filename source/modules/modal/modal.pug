mixin md-survey-success
  .md-survey-success.modal.fade(tabindex='-1')
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-body
            button.btn-close(type="button", data-bs-dismiss="modal")
            .md-survey-success__text-1 Sở Công Thương trân trọng
                br
                | cảm ơn bạn đã tham gia khảo sát!
            .md-survey-success__text-2 Chúc doanh nghiệp luôn thành công.
