mixin md-sample-detail
  .md-sample-detail.modal.fade(tabindex='-1')
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header
            h4.modal-title Chi tiết ảnh hiện vật
            button.md-sample-detail__close(type="button", data-bs-dismiss="modal")
        .modal-body
            .md-sample-detail__heading Ảnh hiện vật
            .md-sample-detail__grid
