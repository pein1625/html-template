mixin md-confirm
  // todo hapk update data to modal confirm
  .md-confirm.modal.fade(tabindex='-1')
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-body
            h3.md-confirm__title XÁC NHẬN THÔNG TIN

            .md-confirm__grid
                .md-confirm__col
                    .row.gy-2.gx-3
                        .col-lg-6
                            .md-confirm__field(data-name="fullname")
                                span Họ và tên:
                                strong
                        .col-lg-6
                            .md-confirm__field(data-name="phone")
                                span Số điện thoại:
                                strong
                        .col-lg-9
                            .md-confirm__field(data-name="address")
                                span Địa chỉ:
                                strong
                        .col-lg-3
                            .md-confirm__field(data-name="province")
                                span Tỉnh/TP:
                                strong
                        .col-lg-6
                            .md-confirm__field(data-name="id_number")
                                span.js-label-number Số CCCD:
                                strong
                        .col-lg-3
                            .md-confirm__field(data-name="id_place")
                                span Nơi đăng ký:
                                strong
                        .col-lg-3
                            .md-confirm__field(data-name="id_date")
                                span Ngày cấp:
                                strong
                .md-confirm__col
                    .row.gy-2.gx-3
                        .col-6
                            .cccd-preview.js-modal-preview-id-front
                        .col-6.js-show-back-photo
                            .cccd-preview.js-modal-preview-id-back

                .md-confirm__col
                    .row.gy-2.gx-3
                        .col-12
                            .md-confirm__field(data-name="product_code")
                                span Ký hiệu:
                                strong
                        .col-lg-6
                            .md-confirm__field(data-name="chassis_number")
                                span Số khung:
                                strong
                        .col-lg-6
                            .md-confirm__field(data-name="machine_number")
                                span Số máy:
                                strong
                        .col-lg-6
                            .md-confirm__field(data-name="bill_number")
                                span Số hoá đơn
                                strong
                        .col-lg-6
                            .md-confirm__field(data-name="bill_date")
                                span Ngày hoá đơn
                                strong

                .md-confirm__col
                    .bill-preview.js-modal-preview-bill

            .text-center.text-danger.my-4.font-italic Kiểm tra kỹ thông tin trước khi nhấn nút

            .row.gy-2.gx-40.justify-content-center
                .col-lg-5
                    button.button.button--block.button--red.text-uppercase(type="button", data-bs-dismiss="modal") Chỉnh sửa thông tin
                .col-lg-5
                    button.button.button--block.button--secondary.text-uppercase.js-modal-confirm-submit(type="button") Hoàn thành & quay thưởng

mixin md-gift
  .md-gift.modal.fade(tabindex='-1')
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-title.text-center.pt-4.fw-700(style="font-size: 20px;")
            div Quý khách đã trúng thưởng
            div Xe máy Vespa
        .modal-body
            img.w100(src="./images/game-bike.png", alt="")
            .text-center.mt-4
                a.button(href="#!") In xác nhận quà tặng

mixin md-login
  .md-login.modal.fade(tabindex='-1')
        .modal-dialog.modal-dialog-centered
            .modal-content
                .modal-body
                    .md-login__logo
                        img(src="./images/logo.png", alt="")

                    .md-login__title Chào mừng
                    .md-login__desc Bạn đang đăng nhập với tư cách thành viên

                    .md-login__form
                        .mb-3
                            label.form-label Tên đăng nhập
                            input.form-control(type="text")
                        .mb-3
                            label.form-label Mật khẩu
                            .input-group.md-login__password
                                input.form-control(type="password")
                                button.input-group-text.js-toggle-show-password(type="button")
                                    i.fal.fa-eye
                                    i.fal.fa-eye-slash
                        .mb-3
                            .row.g-3.justify-content-between
                                .col-auto
                                    +checkbox
                                        span Lưu mật khẩu
                                .col-auto
                                    a.md-login__link.fw-700(href="#!") Quên mật khẩu?
                        .mt-4
                            button.md-login__submit.button(type="submit") Đăng nhập
                    .md-login__copyright Copyright © 2024
