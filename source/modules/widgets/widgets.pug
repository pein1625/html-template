mixin s-map(className='')
    section.section-2.s-map.js-section#s-map(class=className)
        h2.section-2__title.s-map__title Vị trí các điểm đến
        +map

mixin s-news(title='Cụm di tích liên quan', className='', id='')
    section.section-2.js-section(class=className, id=id)
        .container
            h2.section-2__title= title
            +news-slider

