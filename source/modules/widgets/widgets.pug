mixin s-sample(title='', linktext='', id='')
    section.s-sample.js-section(id=id)
        .s-sample__overlay
        .container
            .s-sample__header
                h2.s-sample__title= title
                if (linktext)
                    a.s-sample__link(href="#!")
                        i.far.fa-angle-double-right.me-2.text-secondary
                        span= linktext
            +card-slider-2
                each item, index in ['Sư tử đá', 'Con dấu hình rồng', 'Tượng điêu khắc', 'Trống đồng']
                    .swiper-slide
                        +sample(`./images/img-${index % 5 + 1}.jpg`, item)

mixin s-virtual(subtitle='CỤM DI  TÍCH', title='Xã Hạ Mỗ')
    section.banner#s-virtual.js-section
        .banner__bg
            iframe(src="https://danphuong.zend.website/banner-360/", frameborder="0")
        .banner__wrapper
            img.banner__icon(src="./images/icon-360.svg", alt="")
            h3.banner__subtitle= subtitle
            h2.banner__title= title
            .banner__desc
                i.fal.fa-map-marker-alt.me-2
                span Đình Vạn Xuân - Xã Hạ Mỗ, Huyện Đan Phượng
            .banner__btn-wrap
                a.button.js-experience(href="#!") Trải nghiệm 360

mixin s-album
    section#s-album.s-album.section-2.js-section
        img.s-album__texture-5(src="./images/texture-5.png", alt="")
        img.s-album__texture-6(src="./images/texture-6.png", alt="")

        .container
            h2.section-2__title.text-white Album ảnh

            +place-slider

            .mt-20.mt-xl-4
                +place-thumb-slider

            .mt-3.text-center
                a.link-view-album(href="#md-album-place", data-bs-toggle="modal")
                    i.fal.fa-angle-double-right.text-secondary.me-2
                    span.text-white Xem tất cả Album ảnh của điểm đến
