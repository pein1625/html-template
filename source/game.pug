extends layout/page

block header
    +header-3
block footer

mixin box
    .box
        img.box__box(src="./images/opening-box.png", alt="")
        .box__gift
            .box__img.box__special
                img(src="./images/prize_first.png", alt="")
            .box__img.box__first
                img(src="./images/prize_second.png", alt="")
            .box__img.box__second
                img(src="./images/prize_third.png", alt="")
            .box__img.box__consolation
                img(src="./images/prize_consolation.png", alt="")

mixin giftbox
    .giftbox
        .giftbox__grid
            .giftbox__item.js-giftbox
                img.giftbox__img(src="./images/giftbox-new.png", alt="", data-pos="left")
            .giftbox__item.js-giftbox
                img.giftbox__img(src="./images/giftbox-new.png", alt="", data-pos="right")
            .giftbox__item.js-giftbox
                img.giftbox__img(src="./images/giftbox-new.png", alt="", data-pos="left")
            .giftbox__item.js-giftbox
                img.giftbox__img(src="./images/giftbox-new.png", alt="", data-pos="right")
            .giftbox__item.js-giftbox
                img.giftbox__img(src="./images/giftbox-new.png", alt="", data-pos="center")
            .giftbox__item.js-giftbox
                img.giftbox__img(src="./images/giftbox-new.png", alt="", data-pos="center")

mixin congrat(type="first")
    .congrat(class=type)
        .congrat__title Chúc mừng
        .congrat__subtitle Quý khách đã trúng thưởng
        if (type == "first")
            .congrat__content
                div Giải đặc biệt
                div 01 Xe máy PIAGGIO LIBERTY
            .congrat__last 125 phiên bản Z
        else if (type == "second")
            .congrat__content
                div Giải nhất
                div 01 Thùng đựng đồ Vespa
            .congrat__last
                div 32L đi kèm giá đỡ
                div hoặc
            .congrat__content
                div 01 Thùng đựng đồ Liberty
            .congrat__last
                div 31L đi kèm nắp đậy
        else if (type == "third")
            .congrat__content
                div Giải nhì
                div 01 mũ bảo hiểm Vespa
        else
            .congrat__content
                div Giải khuyến khích
                div 01 Lì xì phụ kiện
            .congrat__last Trị giá 500.000 VNĐ

block content
    section.game(data-url="http://piaggio.hapk.com/ajax/random_gift?customer_ukey=1FUEWJKC")
        img.game__bg(src="./images/game-bg.jpg", alt="")

        .game__title
            div Chọn ngay
            div #[span.text-danger 01] hộp quà may mắn

        +giftbox
        +box

        +congrat('special')
        +congrat('first')
        +congrat('second')
        +congrat('consolation')

        .game-print-btn-wrap
            a.game-print-btn.button.button--secondary(href="#!") In xác nhận quà tặng
