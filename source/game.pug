extends layout/page

block header
    +header-3
block footer

mixin giftbox
    .giftbox
        img.giftbox__img.giftbox__img--1.js-giftbox(src="./images/giftbox-left.png", alt="", data-pos="left")
        img.giftbox__img.giftbox__img--2.js-giftbox(src="./images/giftbox-right.png", alt="", data-pos="right")
        img.giftbox__img.giftbox__img--3.js-giftbox(src="./images/giftbox-left.png", alt="", data-pos="left")
        img.giftbox__img.giftbox__img--4.js-giftbox(src="./images/giftbox-right.png", alt="", data-pos="right")
        img.giftbox__img.giftbox__img--5.js-giftbox(src="./images/giftbox-center.png", alt="", data-pos="center")

        .box
            img.box__box(src="./images/box_sprite.png", alt="")
            .box__gift
                img.box__first(src="./images/prize_first.png", alt="")
                img.box__second(src="./images/prize_second.png", alt="")
                img.box__third(src="./images/prize_third.png", alt="")
                img.box__fourth(src="./images/prize_fourth.png", alt="")
                img.box__consolation(src="./images/prize_consolation.png", alt="")

mixin congrat(type="first")
    .congrat(class=type)
        .congrat__title Chúc mừng
        .congrat__subtitle Quý khách đã trúng thưởng
        if (type == "first")
            .congrat__content
                div Giải nhất
                div 01 Xe Piaggio MEDLEY S
            .congrat__last 125 ABS sản xuất năm 2024
        else if (type == "second")
            .congrat__content
                div Giải Nhì
                div 01 Xe Piaggio Liberty S
            .congrat__last 125 3Vie ABS sản xuất năm 2022
        else if (type == "third")
            .congrat__content
                div Giải BA
                div 01 THÙNG ĐỰNG ĐỒ VESPA 32L
            .congrat__last đi kèm giá đỡ
        else if (type == "fourth")
            .congrat__content
                div Giải TƯ
                div 01 MŨ BẢO HIỂM VESPA
                div NATION JET
        else
            .congrat__content
                div Giải KHUYẾN KHÍCH
                div 01 VOUCHER PHỤ KIỆN
            .congrat__last Trị giá 400.000 VNĐ

block content
    section.game(data-url="http://piaggio.hapk.com/ajax/random_gift?customer_ukey=1FUEWJKC")
        img.game__bg(src="./images/game-bg.jpg", alt="")
        img.game__liberty(src="./images/liberty_s.png", alt="")
        img.game__medley(src="./images/medley_s_bronze.png", alt="")

        .game__title
            .fw-700 Chọn ngay
            div 01 hộp quà may mắn

        .game__gifts
            +giftbox

        +congrat('first')
        +congrat('second')
        +congrat('third')
        +congrat('fourth')
        +congrat('consolation')

        a.game-print-btn.button.button--secondary(href="#!") In xác nhận quà tặng
