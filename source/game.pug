extends layout/page

block header
    +header-3
block footer


mixin giftbox
    .giftbox
        img.giftbox__img.giftbox__img--1.js-giftbox(src="./images/giftbox-left.png", alt="", data-giftbox="1")
        img.giftbox__img.giftbox__img--2.js-giftbox(src="./images/giftbox-right.png", alt="", data-giftbox="2")
        img.giftbox__img.giftbox__img--3.js-giftbox(src="./images/giftbox-left.png", alt="", data-giftbox="3")
        img.giftbox__img.giftbox__img--4.js-giftbox(src="./images/giftbox-right.png", alt="", data-giftbox="4")
        img.giftbox__img.giftbox__img--5.js-giftbox(src="./images/giftbox-center.png", alt="", data-giftbox="5")

block content
    section.game
        img.game__bg(src="./images/game-bg.jpg", alt="")
        //- img.game__sky(src="./images/game-sky.jpg", alt="")
        //- img.game__stage(src="./images/game-yard.jpg", alt="")

        img.game__liberty.d-none(src="./images/liberty_s.png", alt="")
        img.game__medley.d-none(src="./images/medley_s_bronze.png", alt="")

        .game__title.d-none
            .fw-700 Chọn ngay
            div 01 hộp quà may mắn

        .game__gifts.d-none
            +giftbox

        .game__congrat.d-none
            .game__congrat-title Chúc mừng
            div Quý khách đã trúng thưởng
            .fw-700.text-uppercase Giải nhì
            .fw-700.text-uppercase 01 Xe Piaggio Liberty S
            div 125 3Vie ABS sản xuất năm 2022

        a.game__print-btn.button.button--secondary(href="#!") In xác nhận quà tặng

        .box(style="width: 500px")
            img.box__box(src="./images/box_sprite.png", alt="")
            .box__gift
                img(src="./images/liberty_s.png", alt="")
            //- .sprite-animation

        //- .sprite-animation
