extends layout/page

block content
    +breadcrumb('Trang chủ', 'Sản phẩm')

    section.post.pt-10.pb-60
        .container
            h1.post__title Đồ trang trí bằng gốm sứ Bát Tràng
            .row
                .col-lg-8.mb-30.mb-lg-0
                    +post-body
                .col-lg-4
                    section.aside
                        h2.aside__title Bài viết liên quan
                        - for(let i = 0; i < 5; i++)
                            .mt-3
                                +news-2
