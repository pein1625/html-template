extends layout/page

block header
    +header-2
block footer
block content
    section.section.section--page
        img.section__bg(src="./images/rule-bg.jpg", alt="")
        .section__backdrop
        .container
            .section__inner
                .section__header
                    .section__title.text-white ĐĂNG KÝ QUAY TRÚNG THƯỞNG XE
                    .section__desc.text-white
                        p Công ty Piaggio Việt Nam sẽ kiểm tra chi tiết từng thông tin khách hàng đăng ký, nếu có bất kỳ thông tin sai hoặc phát hiện gian lận, Đại lý sẽ phải chịu trách nhiệm.
                            br
                            | Mỗi khách hàng chỉ được đăng ký một lần và không được chỉnh sửa. Vì vậy Đại lý cần kiểm tra thông tin kỹ trước khi hoàn tất đăng ký
                .section__body
                    .section__content
                        form.register-form.js-register-form(action="#!")
                            .row.gy-2.gx-3
                                .col-xl-6
                                    .row.gy-2.gx-3
                                        .col-lg-6
                                            label.form-label Họ và tên
                                            input.form-control(type="text", name="fullname")
                                        .col-lg-6
                                            label.form-label Số điện thoại
                                            .input-group
                                                select.form-select(style="flex: 0 0 80px;")
                                                    option US
                                                    option VN
                                                    option CN
                                                    option CA
                                                input.form-control(type="text", name="phone")
                                        .col-lg-6
                                            label.form-label Địa chỉ khách hàng
                                            input.form-control(type="text", name="address")
                                        .col-lg-6
                                            label.form-label Tỉnh/thành phố
                                            input.form-control(type="text", name="province")
                                        .col-12
                                            //- label.form-label Số CMND/Số hộ khẩu/Hộ chiếu
                                            .d-flex
                                                .me-2
                                                    +radio('type_of_id', '', 'js-input-cccd')
                                                        | &nbsp;Số CCCD
                                                .me-2
                                                    +radio('type_of_id', '', 'js-input-shk')
                                                        | &nbsp;Số hộ khẩu
                                                .me-2
                                                    +radio('type_of_id', '', 'js-input-passport')
                                                        | &nbsp;Hộ chiếu
                                            .position-relative
                                                input.form-control(type="text", name="id_number")
                                                .register-form__upload-btns
                                                    // todo hapk upload to show preview
                                                    label.register-form__upload-btn.js-front-upload-btn
                                                        input.js-file-input(type="file", data-preview=".js-preview-id-front", accept="image/png, image/jpeg")
                                                        i.fal.fa-fw.fa-upload.me-2
                                                        span Tải mặt trước
                                                    label.register-form__upload-btn.js-back-upload-btn
                                                        input.js-file-input(type="file", data-preview=".js-preview-id-back", accept="image/png, image/jpeg")
                                                        i.fal.fa-fw.fa-upload.me-2
                                                        span Tải mặt sau
                                        .col-lg-6
                                            .mb-3.js-show-label
                                                label.form-label.js-label-place Nơi đăng ký CCCD
                                                input.form-control(type="text", name="id_place")
                                            div.js-show-label
                                                label.form-label.js-label-date Ngày cấp CCCD
                                                .input-group.input-group-custom
                                                    input.form-control.js-datepicker(type="text", name="id_date")
                                                    span.input-group-text
                                                        i.fal.fa-fw.fa-calendar-alt
                                        .col-lg-6
                                            .row.gy-2.gx-3
                                                .col-6
                                                    .cccd-preview.js-preview-id-front
                                                .col-6.js-show-back-photo
                                                    .cccd-preview.js-preview-id-back
                                                .col-12
                                                    .text-gray.fs-12
                                                        | * Đối với sổ hộ khẩu hoặc hộ chiều thì chỉ tải lên ở nút “Tải mặt trước”
                                                        br
                                                        | * Đối với CCCD phải tải lên cả hai mặt

                                .col-xl-6
                                    .row.gy-2.gx-3
                                        .col-12
                                            label.form-label Mã hàng hóa
                                            input.form-control(type="text", name="product_code")
                                        .col-lg-6
                                            label.form-label Số khung
                                            input.form-control(type="text", name="chassis_number", placeholder="")
                                        .col-lg-6
                                            label.form-label Số máy
                                            .input-group
                                                select.form-select(style="flex: 0 0 100px;")
                                                    option ABCDE
                                                    option ABCDE
                                                    option ABCDE
                                                    option ABCDE
                                                input.form-control(type="text", name="machine_number", placeholder="")
                                        .col-12
                                            label.form-label Số hóa đơn
                                            .position-relative
                                                input.form-control(type="text", name="bill_number")
                                                .register-form__upload-btns
                                                    label.register-form__upload-btn
                                                        input.js-file-input(type="file", data-preview=".js-preview-bill", accept="image/png, image/jpeg")
                                                        i.fal.fa-fw.fa-upload.me-2
                                                        span Tải hình ảnh
                                        .col-lg-6.me-auto
                                            label.form-label Ngày hóa đơn
                                            .input-group.input-group-custom
                                                input.form-control.js-datepicker(type="text", name="bill_date")
                                                span.input-group-text
                                                    i.fal.fa-fw.fa-calendar-alt
                                        .col-lg-3
                                            .cccd-preview.js-preview-bill

                                .col-12.text-center.text-danger Kiểm tra kỹ thông tin trước khi nhấn nút
                                .col-lg-4
                                    .text-gray.fs-12 Ghi chú: Mỗi số iện thoại chỉ được đăng ký 1 lần duy nhất. Trường hợp khách hàng mua nhiều xe và muốn đăng ký bằng các số điện thoại khác nhau, đại lý vui lòng liên hệ đại diện bán hàng của Piaggio Việt Nam để ược hỗ trợ.
                                .col-lg-4.align-self-center
                                    button.button.button--secondary.button--block.text-uppercase.js-open-confirm-modal(type="button") Hoàn thành & quay thưởng

                .section__footer
                    nav.page-nav
                        a.button(href="./program.html") Trang chủ
                        a.button(href="./rule.html") Thể lệ
                        a.button.active(href="./register.html") Đăng ký
                        a.button(href="./customers.html") Danh sách khách hàng
                        a.button(href="./profile.html") Thông tin người dùng

    +md-confirm
