extends layout/page

block header
block footer
block content
    section.s-page
        header.s-page__header
            .container
                .s-page__header-inner
                    a.s-page__logo(href="./index.html")
                        img(src="./images/logo.png", alt="")
                    .s-page__header-title.text-white DANH SÁCH KHÁCH HÀNG

        main.s-page__body
            .s-page__body-inner.s-page__body-inner--scrollable
                .container-fluid
                    .data-tbl.data-tbl--customer
                        table.table.table-borderless.js-datatable
                            thead
                                tr
                                    th STT
                                    th Mã khách hàng
                                    th Họ tên
                                    th Số điện thoại
                                    th Địa chỉ
                                    th Thành phố
                                    th CMND/SHK/HC
                                    th Ngày hóa đơn
                                    th Ngày đăng ký
                                    th Mã hàng hóa
                                    th Số khung
                                    th Số máy
                                    th Số hóa đơn
                                    th Giải thưởng
                                    th In XN trúng thưởng
                            tbody
                                - for(let i = 0; i < 15; i++)
                                    tr
                                        td #{i >= 9 ? (i + 1) : '0' + (i+1)}
                                        td 0036868
                                        td A Thắng
                                        td 0987654321
                                        td PCK
                                        td Hà Nội
                                        td 011921131
                                        td 15/10/2024
                                        td 20/10/2024
                                        td A03
                                        td U5568
                                        td 8868
                                        td S330
                                        td Vespa
                                        td
                                            a(href="#!") In ấn

                        .data-tbl__footer
                            .data-tbl__search
                                .input-group
                                    input.form-control(type="text", placeholder="Tìm kiếm thông tin")
                                    button.input-group-text(type="button")
                                        i.far.fa-lg.fa-search

                            .data-tbl__content
                                div Có #[strong.text-danger 93] đại lý trong danh sách này

                            .data-tbl__pagination
                                +pagination


        footer.s-page__footer
            .container
                nav.s-page__nav
                    a.button(href="./program.html") Trang chủ
                    a.button(href="./rule.html") Thể lệ
                    a.button(href="./register.html") Đăng ký
                    a.button.active(href="./customers.html") Danh sách khách hàng
                    a.button(href="./profile.html") Thông tin người dùng
