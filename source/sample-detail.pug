            .text-center.mt-40
                a.arrow-down(href="#s-album")
                    i.fal.fa-arrow-down

    +s-album
    +s-news('Điểm đến liên quan', '', 's-post')
    +s-news('Các bài viết liên quan', 'pt-0')

    +md-album-sample
