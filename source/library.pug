extends layout/page

block content
    +breadcrumb('Trang chủ', 'Thư viện')

    section.section.pt-10.pb-60
        .container
            h1.section__title Thư viện

            .mx-auto.mt-4(style="max-width: 800px")
                +search-field

                .d-flex.flex-wrap.align-items-center.justify-content-between.gap-4.mt-3.mb-4.mb-lg-40
                    nav.tags.me-auto
                        a.tags__item.active(href="#!") Tất cả
                        a.tags__item(href="#!") Hình ảnh
                        a.tags__item(href="#!") Hình ảnh 3D
                        a.tags__item(href="#!") Videos
                    .custom-daterangepicker
                        .input-group
                            span.input-group-text
                                i.fal.fa-fw.fa-calendar
                            input.form-control(type="text" class="js-daterangepicker")

            .row.g-3.g-xl-30
                - for(let i = 0; i < 12; i++)
                    .col-6.col-lg-3
                        +lib(`./images/img-${i % 5 + 1}.jpg`)
                each item in ['f4qHIxmyXt4', 'jAEjfiOH-3w', 'uzt1NCn9BY4', '01dn67QubYQ', 'HaIjR05n1Vc']
                    .col-6.col-lg-3
                        +lib-2(item)
                - for(let i = 0; i < 3; i++)
                    .col-6.col-lg-3
                        +lib-3

            nav.d-flex.justify-content-center.mt-30
                +pagination
