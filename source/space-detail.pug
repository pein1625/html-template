extends layout/page

block content
    +float-breadcrumb('Trang chủ', 'Không gian 360', 'Chi tiết không gian 360')

    nav.page-nav
        .page-nav__wrapper
            .container
                .page-nav__inner
                    a.s-btn.active(href="#s-virtual") Vrtour
                    a.s-btn(href="#s-about") Giới thiệu
                    a.s-btn(href="#s-sample") Cụm di tích
                    a.s-btn(href="#s-position") Vị trí
                    a.s-btn(href="#s-post") Thông tin liên quan

    +s-virtual
    +s-about('Giới thiệu', 'Cụm di tích Xã Hạ Mỗ')
    +s-sample('Danh sách điểm đến của cụm di tích', 'Xem tất cả điểm đến của cụm di tích', 's-sample')
    +s-map
    +s-news('Cụm di tích liên quan', '', 's-position')
    +s-news('Các bài viết liên quan', 'pt-0', 's-post')
