extends layout/page

block header
    +header-2
block footer
block content
    section.section.section--page.py-0
        img.section__bg.d-none.d-md-block(src="./images/banner-bg.jpg", alt="")
        img.banner-items.d-none.d-md-block(src="./images/banner-items.png", alt="")
        .mobile-bg.d-md-none
            img.mobile-bg__1(src="./images/mobile-bg-1.jpg", alt="")
            img.mobile-bg__2(src="./images/mobile-bg-2.png", alt="")
            img.mobile-bg__3(src="./images/mobile-bg-3.png", alt="")
        .container
            .section__inner.pt-30.pb-3.pb-md-30
                .section__body
                .section__footer
                    nav.page-nav
                        a.button.active(href="./program.html") Trang chủ
                        a.button(href="./rule.html") Thể lệ
                        a.button(href="./register.html") Đăng ký
                        a.button(href="./customers.html") Danh sách khách hàng
                        a.button(href="./profile.html") Thông tin người dùng
