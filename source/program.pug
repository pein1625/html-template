extends layout/page

block header
block footer
block content
    section.s-page
        img.s-page__bg(src="./images/vespa-front-yellow.png", alt="")

        header.s-page__header
            .container
                a.s-page__logo(href="./index.html")
                    img(src="./images/logo.png", alt="")

        main.s-page__body
            .container
                h1.s-page__title Chương trình “Lên xe sang - đón ngàn lộc”
                .s-page__desc Công ty Piaggio Việt Nam gửi tới khách hàng thông báo chương trình khuyến mại “Lên xe sang - ón ngàn lộc” với mong muốn tri ân khách hàng đã tin tưởng và ồng hành cùng Piaggio Việt Nam trong năm vừa qua và mong muốn mang lại cho khách hàng những trải nghiệm tuyệt vời về hoạt động dịch vụ chính hãng tại các cửa hàng bán xe máy và dịch vụ do Piaggio Việt Nam uỷ nhiệm.

        footer.s-page__footer
            .container
                nav.s-page__nav
                    a.button.active(href="#!") Trang chủ
                    a.button(href="#!") Thể lệ
                    a.button(href="#!") Đăng ký
                    a.button(href="#!") Danh sách khách hàng
                    a.button(href="#!") Thông tin người dùng
