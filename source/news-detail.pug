extends layout/page

block content
    +breadcrumb('Trang chủ', 'Tin tức', 'Bài viết')

    section.post
        .container
            h1.post__title Lorem ipsum dolor sit amet consectetuer

            .row
                .col-lg-8.col-xl-9.mb-40.mb-lg-0
                    +post-body

                .col-lg-4.col-xl-3
                    section.aside
                        h2.aside__title Bài viết mới nhất
                        - for(let i = 0; i < 3; i++)
                            .mt-3
                                +news-2

                    section.aside.mt-60
                        h2.aside__title Bài viết nổi bật
                        - for(let i = 0; i < 3; i++)
                            .mt-3
                                +news-2
